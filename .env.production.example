APP_PORT=5001
FLASK_DEBUG=0

# Supabase Postgres connection string.
# Use the connection string from Supabase Project Settings > Database.
# Either DATABASE_URL or SUPABASE_DB_URL is accepted by the app.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

WTF_CSRF_ENABLED=1
SESSION_COOKIE_SECURE=1
SESSION_LIFETIME_MINUTES=480
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
MAX_UPLOAD_MB=16
ENABLE_HSTS=1
SHOW_DEMO_CREDENTIALS=0

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_DISPLAY_NAME=Responsabile
OPERATOR_USERNAME=operatore
OPERATOR_PASSWORD=replace-with-strong-operator-password
OPERATOR_DISPLAY_NAME=Operatore Demo
